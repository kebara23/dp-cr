# ---- Database (Postgres + pgvector) ----
# Local docker-compose default; override with Neon/Railway URL in prod
DATABASE_URL="postgresql://dpcr:dpcr@localhost:5432/dpcr?schema=public"

# ---- Redis (Upstash in prod, local docker for dev) ----
REDIS_URL="redis://localhost:6379"

# ---- Auth (Clerk) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ---- Object storage (Cloudflare R2 / S3) ----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="dpcr-laminas"
R2_PUBLIC_URL=""

# ---- IA (Anthropic Claude) ----
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"

# ---- Embeddings (OpenAI text-embedding-3-small o Voyage) ----
EMBEDDINGS_PROVIDER="openai"
OPENAI_API_KEY=""
EMBEDDINGS_MODEL="text-embedding-3-small"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
